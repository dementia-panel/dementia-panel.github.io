# Web
PUBLIC_URL='https://panel.example.com'
PANEL_BIND=127.0.0.1
PANEL_PORT=443
# Logging (local, dev, prod, test; optional level override)
MODE=prod
LOG_LEVEL=''

# PostgreSQL
POSTGRES_USER=backend
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=backend

# Secrets
JWT_SIGNING_KEY=''
ENCRYPTION_KEY=''

# Nodes
NODE_PING_INTERVAL_SECONDS=30

# Webhook
WEBHOOK_URL=''
WEBHOOK_SECRET_HEADER=''

# Telegram
TELEGRAM_BOT_TOKEN=''
TELEGRAM_MODE=polling
TELEGRAM_CHAT_ID=''
TELEGRAM_THREAD_ID=''
TELEGRAM_WEBHOOK_SECRET=''
